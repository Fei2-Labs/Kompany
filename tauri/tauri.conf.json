{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kompany",
  "version": "0.1.0",
  "identifier": "com.kompany.desktop",
  "build": {
    "frontendDist": "src-tauri/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kompany",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "url": "about:blank",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": [
      "../icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Autonomous business operating system",
    "longDescription": "Kompany runs an autonomous C-suite for solo founders. The desktop app spawns a local Python sidecar and shows the cyberpunk dashboard in a native window.",
    "externalBin": [
      "binaries/kompany-server"
    ],
    "macOS": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    }
  }
}
